{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug Simulator Test",
      "program": "${workspaceFolder}/build/tests/sim8086_tests",
      "args": ["--gtest_filter=SimulatorExecution*"],
      "cwd": "${workspaceFolder}/build",
      "env": { "TEST_DATA_DIR": "../listings" }
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug Last Simulator Test",
      "program": "${workspaceFolder}/build/tests/sim8086_tests",
      "args": [
        "--gtest_filter=SimulatorExecution/SimulatorTest.ExecutionOutput/8"
      ],
      "cwd": "${workspaceFolder}/build",
      "env": { "TEST_DATA_DIR": "../listings" }
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug sim8086",
      "program": "${workspaceFolder}/build/sim8086",
      "args": ["./listings/listing_0041_add_sub_cmp_jnz"],
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug Haversine Processor",
      "program": "${workspaceFolder}/build/projects/haversine/haversine_processor",
      "args": [
        "${workspaceFolder}/build/projects/haversine/data_json_1000000.json",
        "${workspaceFolder}/build/projects/haversine/data_bin_1000000.f64",
        "-p"
      ],
      "cwd": "${workspaceFolder}/build/projects/haversine"
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug Repetition Tester",
      "program": "${workspaceFolder}/repetition_tester",
      "args": ["${workspaceFolder}/build/projects/haversine/data_1000000.json"],
      "cwd": "${workspaceFolder}/build/projects/haversine",
      "initCommands": [
        "settings set target.x86-disassembly-flavor intel"
      ]
    }
  ]
}
